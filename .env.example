# Development-only credentials. Choose a different password outside local development.
POSTGRES_USER=clipforge
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=clipforge

# Speech-to-text (keep real keys in .env, never in this example)
DEEPGRAM_API_KEY=
# Select global or india. Requests opt out of model improvement in both regions.
DEEPGRAM_REGION=global

# Optional: experimental AI-assisted candidate suggestions
OPENAI_API_KEY=
